[Desktop Entry]
Name=Newelle
Comment=Newelle: Your advanced chat bot
Exec=env DRI_PRIME=1 HF_ENDPOINT=https://hf-mirror.com newelle
Icon=io.github.qwersyk.Newelle
Terminal=false
Type=Application
Categories=Utility;
StartupNotify=true
Keywords=ai;assistant;chat;llm;
Actions=mini-window;

[Desktop Action mini-window]
Name=Mini Window
Exec=env DRI_PRIME=1 HF_ENDPOINT=https://f-mirror.com newelle --mini
Icon=io.github.qwersyk.Newelle
