[Desktop Entry]
Name=Newelle
Comment=Newelle: Your advanced chat bot
Exec=env DRI_PRIME=1 newelle
Icon=io.github.qwersyk.Newelle
Terminal=false
Type=Application
Categories=Utility;
StartupNotify=true
Keywords=ai;assistant;chat;chatgpt;gpt;llm;ollama;
Actions=mini-window;voice-mode;

[Desktop Action mini-window]
Name=Mini Window
Exec=env DRI_PRIME=1 newelle --mini
Icon=io.github.qwersyk.Newelle

[Desktop Action voice-mode]
Name=Voice Mode
Exec=env DRI_PRIME=1 newelle --voice
Icon=io.github.qwersyk.Newelle
